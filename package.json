{
  "name": "the-python-graph-gallery",
  "private": true,
  "description": "A gallery displaying hundreds of charts made with Python with their reproducible code",
  "version": "1.0.0",
  "license": "0BSD",
  "scripts": {
    "dev": "npm run prepare-assets && next dev",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "build": "npm run prepare-assets && next build && tsx scripts/postbuild.ts",
    "serve": "npx serve out",
    "seo-diff": "tsx scripts/seo-diff.ts",
    "deploy": "npm run build && gh-pages -d out --dotfiles",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holtzy/The-Python-Graph-Gallery"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3": "^7.9.0",
    "d3-voronoi": "^1.1.4",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
